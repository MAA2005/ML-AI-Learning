# Relay — example environment. Copy to `.env` and fill in ONLY your own keys.
# Nothing in here ships with a default credential. Blank = provider disabled.
#
# PREFERRED: add keys via `relay add-provider <id>` — they go in the OS keychain
# (or the passphrase-encrypted file below), validated live before saving, and
# never land in plaintext. The env keys further down are a dev/headless fallback.

# Server
RELAY_HOST=127.0.0.1
RELAY_PORT=8787

# --- Encrypted key store ---
# If no OS keychain is available, the encrypted-file store is used and REQUIRES
# a passphrase (scrypt + AES-256-GCM). Missing/wrong passphrase fails loudly —
# Relay never falls back to storing keys unencrypted.
RELAY_PASSPHRASE=
# Set to "file" to force the encrypted file store even when a keychain exists.
RELAY_KEY_BACKEND=

# --- Provider API keys (yours only) ---
# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
# Uses the NATIVE Messages API adapter (x-api-key auth), not an OpenAI shim.
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (Groq, Together, local vLLM, etc.)
# Set base URL + key explicitly; no vendor defaults are assumed.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Local Ollama (no key needed; typically http://127.0.0.1:11434/v1)
OLLAMA_BASE_URL=
